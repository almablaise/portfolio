---
import Base from '../../layouts/Base.astro';
import Img from '../Img.astro';
import ProjectCard from '../ProjectCard.astro';
import Process from '../Process.astro';
import { t, path, type Lang } from '../../i18n/ui';
import { projectsFor } from '../../i18n/routes';
import { site, testimonials } from '../../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const featured = (await projectsFor(lang)).filter((p) => p.data.featured).slice(0, 6);
const quotes = testimonials.filter((q) => q.show !== false);
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="stack">
      <p class="kicker">{s.hero.kicker}</p>
      <h1>{s.hero.title}</h1>
      <p class="lead">{s.hero.text}</p>
      <div class="btns" style="margin-top:40px">
        <a class="btn btn--dark" href="#work">{s.hero.cta1}</a>
        <a class="btn btn--ghost" href="#contact">{s.hero.cta2}</a>
      </div>
    </div>
    <div class="hero-art"><Img src="/images/illustration.png" alt="" label={s.placeholder} ratio="438 / 606" /></div>
  </section>

  <!-- WHY WORK WITH ME : impact + main & IA -->
  <section class="wrap section">
    <p class="kicker">{s.why.kicker}</p>
    <h2 class="why-title">{s.why.title}</h2>
    <div class="pillars">
      {s.why.pillars.map((p, i) => (
        <div class={`pillar ${i === 1 ? 'pillar--dark' : ''}`}>
          <span class="kicker">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
    <div class="handai">
      <ul class="tags">{s.why.hand.map((x) => <li class="tag">{x}</li>)}</ul>
      <span class="times" aria-hidden="true">×</span>
      <ul class="tags">{s.why.ai.map((x) => <li class="tag tag--dark">{x}</li>)}</ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="wrap section">
    <h2>{s.services.title}</h2>
    <div class="services">
      {s.services.items.map((it) => (
        <div class="service">
          <div class="circle"><h3>{it.title}</h3></div>
          <p>{it.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="wrap section" id="work">
    <div class="head"><h2>{s.work.title}</h2><a href={path(lang, 'projects')}>{s.work.all}</a></div>
    <div class="grid">
      {featured.map((p) => <ProjectCard lang={lang} slug={p.slug} data={p.data} />)}
    </div>
  </section>

  <!-- TESTIMONIALS -->
  {quotes.length > 0 && (
    <section class="wrap section">
      <h2 style="margin-bottom:48px">{s.testimonials.title}</h2>
      <div class="quotes">
        {quotes.map((q) => (
          <figure class={`quote ${q.placeholder ? 'quote--ph' : ''}`}>
            <span class="mark" aria-hidden="true">“</span>
            <blockquote>{q.quote[lang]}</blockquote>
            <figcaption><strong>{q.name}</strong><span>{q.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ABOUT TEASER + INTERNATIONAL -->
  <section class="wrap section">
    <h2 style="margin-bottom:48px">{s.aboutTeaser.title}</h2>
    <div class="about">
      <div class="portrait"><Img src="/images/portrait.jpg" alt="Alma Blaise" label={s.placeholder} ratio="1 / 1" round /></div>
      <div class="stack">
        <p class="lead">{s.aboutTeaser.text}</p>
        <a class="btn btn--dark" href={path(lang, 'about')}>{s.aboutTeaser.more}</a>
      </div>
    </div>
    <div class="intl">
      <div class="stack">
        <h3>{s.intl.title}</h3>
        <p>{s.intl.text}</p>
      </div>
      <ul class="langs">
        {s.intl.langs.map((l) => <li class="circle" style="--size:112px"><span><strong>{l.name}</strong><br /><small class="muted">{l.level}</small></span></li>)}
      </ul>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="wrap section">
    <h2>{s.how.title}</h2>
    <p class="lead" style="margin:24px 0 48px">{s.how.text}</p>
    <Process steps={s.how.steps} milestones={s.how.milestones} />
  </section>

  <!-- CONTACT -->
  <section class="wrap section" id="contact">
    <h2>{s.contact.title}</h2>
    <div class="contact">
      <p class="lead">{s.contact.text}</p>
      <dl>
        <div><dt>{s.contact.mail}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>{s.contact.based}</dt><dd>{site.city}</dd></div>
        {site.linkedin && <div><dt>LinkedIn</dt><dd><a href={site.linkedin} target="_blank" rel="noopener">Alma Blaise</a></dd></div>}
        <div><dt>Behance</dt><dd><a href={site.behance} target="_blank" rel="noopener">behance.net/pommeblais430c</a></dd></div>
        <a class="btn btn--dark" href={`mailto:${site.email}`}>{s.contact.cta}</a>
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: 64px; align-items: center; padding-top: clamp(60px, 8vw, 120px); }
  .hero h1 { max-width: 820px; }
  .hero-art { max-width: 400px; justify-self: end; width: 100%; }

  .why-title { margin: 16px 0 48px; max-width: 900px; font-size: clamp(36px, 4vw, 56px); }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .pillar { border: 1px solid var(--ink); border-radius: 4px; padding: 40px 32px; display: flex; flex-direction: column; gap: 20px; }
  .pillar h3 { font-size: 32px; }
  .pillar--dark { background: var(--ink); color: #fff; }
  .handai { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 40px; }
  .times { font-family: var(--serif); font-weight: 700; font-size: 28px; }

  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 48px; }
  .service { display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; }
  .service p { max-width: 340px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 72px 32px; }

  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .quote { margin: 0; border: 1px solid var(--ink); border-radius: 4px; padding: 40px 32px; display: flex; flex-direction: column; gap: 20px; }
  .mark { font-family: var(--serif); font-weight: 700; font-size: 72px; line-height: .6; }
  blockquote { margin: 0; font-family: var(--serif); font-size: 20px; line-height: 1.5; flex: 1; }
  figcaption { display: flex; flex-direction: column; font-size: 14px; }
  figcaption strong { font-size: 16px; }
  .quote--ph blockquote, .quote--ph figcaption { color: var(--muted); }
  .quote--ph { border-style: dashed; }

  .about { display: grid; grid-template-columns: 335px 1fr; gap: 80px; align-items: center; }
  .intl { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: center; margin-top: 80px; padding-top: 48px; border-top: 1px solid var(--ink); }
  .langs { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; margin: 0; padding: 0; justify-content: flex-end; }
  .langs li { font-size: 14px; line-height: 1.3; }

  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px; margin-top: 32px; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  dt { font-size: 14px; }
  dd { margin: 0; font-weight: 700; }

  @media (max-width: 900px) {
    .hero, .about, .intl, .contact { grid-template-columns: 1fr; }
    .hero-art { justify-self: start; max-width: 260px; order: -1; }
    .pillars, .services, .quotes, .grid { grid-template-columns: 1fr; }
    .portrait { max-width: 240px; }
    .langs { justify-content: flex-start; }
  }
</style>
