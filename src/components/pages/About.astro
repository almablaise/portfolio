---
import Base from '../../layouts/Base.astro';
import Img from '../Img.astro';
import { t, path, type Lang } from '../../i18n/ui';
import { site, timeline, hardSkills, softSkills } from '../../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const a = s.about;
// Photos d'équipe : dépose-les dans /public/images/about/ avec ces noms
const photos = ['/images/about/team-1.jpg', '/images/about/team-2.jpg'];
---
<Base lang={lang} title={a.kicker} page="about">
  <!-- INTRO -->
  <section class="wrap intro">
    <div class="stack">
      <p class="kicker">{a.kicker}</p>
      <h1>{a.title}</h1>
      {a.intro.map((p) => <p class="lead">{p}</p>)}
      <div class="btns" style="margin-top:32px">
        <a class="btn btn--dark" href={site.cv} download>{a.cv}</a>
        <a class="btn btn--ghost" href={path(lang) + '#contact'}>{s.nav.contact}</a>
      </div>
    </div>
    <div class="portrait"><Img src="/images/portrait.jpg" alt="Alma Blaise" label={s.placeholder} ratio="1 / 1" round /></div>
  </section>

  <!-- PHOTOS -->
  <section class="wrap section">
    <h2 style="margin-bottom:48px">{a.photosTitle}</h2>
    <div class="photos">
      {photos.map((src, i) => (
        <figure class={`photo photo--${i}`}>
          <Img src={src} alt={a.photos[i]} label={s.placeholder} ratio="4 / 3" />
          <figcaption>{a.photos[i]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- HAND × AI -->
  <section class="wrap section">
    <div class="duo">
      <div class="half">
        <h2>{a.handTitle}</h2>
        <p class="lead">{a.handText}</p>
        <ul class="tags">{s.why.hand.map((x) => <li class="tag">{x}</li>)}</ul>
      </div>
      <span class="times" aria-hidden="true">×</span>
      <div class="half half--dark">
        <h2>{a.aiTitle}</h2>
        <p class="lead">{a.aiText}</p>
        <ul class="tags">{s.why.ai.map((x) => <li class="tag" style="border-color:#fff;color:#fff">{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="wrap section">
    <h2 style="margin-bottom:48px">{a.storyTitle}</h2>
    <ol class="timeline">
      {timeline.map((e) => (
        <li class={e.current ? 'current' : ''}>
          <span class="period">{e.period}</span>
          <div>
            <h3>{e.title[lang]}</h3>
            <p class="place">{e.place}</p>
            <p>{e.text[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- LANGUAGES -->
  <section class="wrap section">
    <div class="intl">
      <div class="stack"><h2>{s.intl.title}</h2><p class="lead">{s.intl.text}</p></div>
      <ul class="langs">
        {s.intl.langs.map((l) => <li class="circle" style="--size:120px"><span><strong>{l.name}</strong><br /><small class="muted">{l.level}</small></span></li>)}
      </ul>
    </div>
  </section>

  <!-- SKILLS + BEYOND -->
  <section class="wrap section">
    <h2 style="margin-bottom:40px">{a.skillsTitle}</h2>
    <div class="skills">
      <div class="stack"><h3>{a.hard}</h3><ul class="tags">{hardSkills.map((x) => <li class="tag">{x}</li>)}</ul></div>
      <div class="stack"><h3>{a.soft}</h3><ul class="tags">{softSkills[lang].map((x) => <li class="tag">{x}</li>)}</ul></div>
    </div>
    <h3 style="margin:80px 0 32px">{a.beyondTitle}</h3>
    <ul class="beyond">
      {a.beyond.map((x) => <li class="circle" style="--size:150px"><span>{x}</span></li>)}
    </ul>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 1.5fr 1fr; gap: 80px; align-items: center; padding-top: 80px; }
  .intro h1 { font-size: clamp(38px, 4.4vw, 64px); }
  .portrait { max-width: 400px; justify-self: end; width: 100%; }

  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .photo { margin: 0; }
  figcaption { font-size: 14px; margin-top: 12px; color: var(--muted); }

  .duo { display: grid; grid-template-columns: 1fr auto 1fr; gap: 32px; align-items: center; }
  .half { border: 1px solid var(--ink); border-radius: 4px; padding: 48px 40px; display: flex; flex-direction: column; gap: 24px; height: 100%; }
  .half--dark { background: var(--ink); color: #fff; }
  .times { font-family: var(--serif); font-weight: 700; font-size: 48px; }

  .timeline { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--ink); }
  .timeline li { display: grid; grid-template-columns: 160px 1fr; gap: 32px; padding: 0 0 48px 32px; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -7px; top: 6px; width: 13px; height: 13px; border-radius: 50%; border: 1px solid var(--ink); background: var(--bg); }
  .timeline li.current::before { background: var(--ink); }
  .period { font-weight: 700; }
  .timeline h3 { font-size: 24px; }
  .place { font-weight: 500; color: var(--muted); margin: 4px 0 8px; }

  .intl { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: center; }
  .langs, .beyond { display: flex; flex-wrap: wrap; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .langs { justify-content: flex-end; }
  .langs li, .beyond li { font-size: 15px; line-height: 1.3; }

  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }

  @media (max-width: 900px) {
    .intro, .intl, .skills, .photos, .duo { grid-template-columns: 1fr; }
    .portrait { justify-self: start; max-width: 240px; order: -1; }
    .times { justify-self: center; }
    .timeline li { grid-template-columns: 1fr; gap: 8px; }
    .langs { justify-content: flex-start; }
  }
</style>
